  </properties>

  <modules>
    <module>junit5-platform-7</module>
    <module>jgiven-platform-7</module>
    <module>spring-test-platform-7</module>
    <module>spring-starter-platform-7</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!-- Own BOM -->
      <dependency>
        <groupId>io.holunda.c7</groupId>
        <artifactId>c7-process-test-coverage-bom</artifactId>
        <version>${project.version}</version>
        <scope>import</scope>
        <type>pom</type>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>


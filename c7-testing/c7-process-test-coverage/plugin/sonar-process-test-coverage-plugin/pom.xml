<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.holunda.c7._</groupId>
    <artifactId>c7-process-test-coverage-parent</artifactId>
    <version>2026.04.3-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <groupId>io.holunda.c7</groupId>

  <artifactId>sonar-camunda-process-test-coverage-plugin</artifactId>
  <name>testing: c7-process-test-coverage - sonar-plugin</name>
  <packaging>sonar-plugin</packaging>
  <properties>
    <sonar-plugin-api.version>14.0.0.4498</sonar-plugin-api.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.sonarsource.api.plugin</groupId>
      <artifactId>sonar-plugin-api</artifactId>
      <version>${sonar-plugin-api.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>c7-process-test-coverage-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.camunda.bpm.model</groupId>
      <artifactId>camunda-bpmn-model</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-js-from-report-generator</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/coverage-viewer</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.parent.basedir}/extension/report-generator/target/classes</directory>
                  <includes>
                    <include>**/*.js</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.sonarsource.sonar-packaging-maven-plugin</groupId>
        <artifactId>sonar-packaging-maven-plugin</artifactId>
        <version>2.0.0.3035</version>
        <extensions>true</extensions>
        <configuration>
          <pluginKey>processtestcoverage</pluginKey>
          <pluginClass>org.camunda.community.process_test_coverage.sonar.ProcessTestCoveragePlugin</pluginClass>
          <pluginSourcesUrl>https://github.com/camunda-community-hub/camunda-process-test-coverage</pluginSourcesUrl>
          <pluginIssueTrackerUrl>https://github.com/camunda-community-hub/camunda-process-test-coverage/issues</pluginIssueTrackerUrl>
          <pluginApiMinVersion>9.9</pluginApiMinVersion>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>sanitize-version-for-pnpm</id>
            <phase>initialize</phase>
            <goals>
              <goal>regex-property</goal>
            </goals>
            <configuration>
              <name>pnpm.compatible.version</name>
              <value>${project.version}</value>
              <!-- Sucht nach einer Null nach einem Punkt, wenn danach eine weitere Zahl folgt -->
              <regex>\.0+(?=\d)</regex>
              <replacement>.</replacement>
              <failIfNoMatch>false</failIfNoMatch>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>install node and corepack</id>
            <phase>initialize</phase>
            <goals>
              <goal>install-node-and-corepack</goal>
            </goals>
          </execution>
          <execution>
            <id>install</id>
            <goals>
              <goal>corepack</goal>
            </goals>
            <configuration>
              <arguments>pnpm install</arguments>
            </configuration>
          </execution>
          <execution>
            <id>npm version</id>
            <phase>initialize</phase>
            <goals>
              <goal>corepack</goal>
            </goals>
            <configuration>
              <arguments>pnpm version ${pnpm.compatible.version} --allow-same-version --no-git-tag-version</arguments>
            </configuration>
          </execution>
          <execution>
            <id>npm run script</id>
            <phase>compile</phase>
            <goals>
              <goal>corepack</goal>
            </goals>
            <configuration>
              <arguments>pnpm run build</arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>

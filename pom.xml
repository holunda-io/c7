<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.toolisticon.maven.parent</groupId>
    <artifactId>maven-parent-kotlin-base</artifactId>
    <version>2026.01.2</version>
    <relativePath/>
  </parent>

  <groupId>io.holunda.c7._</groupId>
  <artifactId>c7-root</artifactId>
  <version>2026.02.2-SNAPSHOT</version>

  <name>pom: ${project.artifactId}</name>
  <description>Root of all holunda/camunda7 libs.</description>
  <url>https://github.com/holunda-io/c7/</url>
  <packaging>pom</packaging>

  <properties>
    <!-- Global versions that are crucial for all submodules. -->
    <camunda-ee.version>7.24.2-ee</camunda-ee.version>
    <camunda-ce.version>7.24.0</camunda-ce.version>
    <spring-boot.version>3.5.10</spring-boot.version>
  </properties>

  <modules>
    <module>_build/parent</module>
    <module>c7-operations/c7-admin-process-registry</module>
    <module>c7-operations/c7-webapp-autologin</module>

    <module>c7-support/c7-api</module>
    <module>c7-support/c7-commons-immutables</module>
    <module>c7-support/c7-correlate</module>
    <module>c7-support/c7-custom-batch</module>
    <module>c7-support/c7-data</module>
    <module>c7-support/c7-deployment</module>
    <module>c7-support/c7-rest-client-spring-boot</module>

    <module>c7-testing/c7-jgiven</module>
    <module>c7-testing/c7-mockito</module>
    <module>c7-testing/c7-process-test-coverage</module>
  </modules>

  <dependencyManagement>
    <!-- empty -->
  </dependencyManagement>

  <dependencies/>

  <profiles>
    <profile>
      <id>examples</id>
      <activation>
        <property>
          <name>!skipExamples</name>
        </property>
      </activation>
      <modules>
        <module>_examples</module>
        <!-- Must be defined as last module -->
        <module>_build/coverage-aggregator</module>
      </modules>
    </profile>
    <!--
    Profile for selecting the Camunda BPM Engine version.
    CE stands for Community Edition
    EE stands for Enterprise Edition
  -->
    <profile>
      <id>camunda-ce</id>
      <activation>
        <property>
          <name>!camunda-ee</name>
        </property>
      </activation>
      <properties>
        <camunda.version>${camunda-ce.version}</camunda.version>
      </properties>
      <dependencyManagement>
        <dependencies>
          <dependency>
            <groupId>org.camunda.bpm.springboot</groupId>
            <artifactId>camunda-bpm-spring-boot-starter-webapp</artifactId>
            <version>${camunda-ce.version}</version>
          </dependency>
        </dependencies>
      </dependencyManagement>
    </profile>
    <profile>
      <id>camunda-ee</id>
      <activation>
        <property>
          <name>camunda-ee</name>
        </property>
      </activation>
      <properties>
        <camunda.version>${camunda-ee.version}</camunda.version>
      </properties>
      <repositories>
        <repository>
          <id>camunda-bpm-ee</id>
          <name>camunda-bpm-ee</name>
          <url>https://artifacts.camunda.com/artifactory/private/</url>
        </repository>
      </repositories>
      <dependencyManagement>
        <dependencies>
          <dependency>
            <groupId>org.camunda.bpm.springboot</groupId>
            <artifactId>camunda-bpm-spring-boot-starter-webapp-ee</artifactId>
            <version>${camunda-ee.version}</version>
          </dependency>
        </dependencies>
      </dependencyManagement>
    </profile>
  </profiles>

  <scm>
    <connection>scm:git:git@github.com:holunda-io/c7.git</connection>
    <url>scm:git:git@github.com:holunda-io/c7.git</url>
    <developerConnection>scm:git:git@github.com:holunda-io/c7.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <developers>
    <developer>
      <id>zambrovski</id>
      <name>Simon Zambrovski</name>
      <roles>
        <role>Product Owner</role>
        <role>Developer</role>
      </roles>
      <organization>Holisticon AG</organization>
      <organizationUrl>https://holisticon.de</organizationUrl>
    </developer>
    <developer>
      <id>jangalinski</id>
      <name>Jan Galinski</name>
      <roles>
        <role>Product Owner</role>
        <role>Developer</role>
      </roles>
      <organization>Holisticon AG</organization>
      <organizationUrl>https://holisticon.de</organizationUrl>
    </developer>
    <developer>
      <id>stefanzilske</id>
      <name>Stefan Zilske</name>
      <roles>
        <role>Product Owner</role>
        <role>Developer</role>
      </roles>
      <organization>Holisticon AG</organization>
      <organizationUrl>https://holisticon.de</organizationUrl>
    </developer>
    <developer>
      <name>Christian Maschmann</name>
      <roles>
        <role>Developer</role>
      </roles>
      <organization>Holisticon AG</organization>
      <organizationUrl>https://holisticon.de</organizationUrl>
    </developer>
  </developers>
</project>
